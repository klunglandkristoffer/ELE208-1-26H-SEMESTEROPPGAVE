<?xml version="1.0"?>

<!--
    AI/KI-deklarasjon:
    SDF-strukturen i denne filen, med et ferdig oppsett for modellblokkene
    er laget av ChatGPT-6.2. Det er basert på gruppens utarbeiding av
    robotdesign og arbeidsmiljø.

    Dimensjoner og koordinater tar utgangspunkt i gruppens
    arbeid i AutoCAD og MATLAB. Tilleggsverdier er
    beregnet eller valgt med KI-assistanse for å
    representere arbeidsmiljøet på en realistisk måte i Gazebo.

    Se kommentarer underveis som forklarer oppbygging av koden,
    valg av verdier og geometriske tilpasninger for visualisering.
-->

<!-- SDF (Simulation Description Format) er et XML-basert format for beskrivelse av simulerbare miljøer -->
<!-- XML er markeringsspråket, mens SDF bestemmer hvilke elementer som er gyldige og hvordan de skal tolkes i Gazebo -->

<sdf version="1.9">

    <world name="challenge5"> 

        <!-- Systemmoduler, for håndtering av fysikk, brukerkommandoer og visualisering, de er standardkomponenter i Gazebo -->

        <plugin filename="gz-sim-physics-system"
                name="gz::sim::systems::Physics"/>

        <plugin filename="gz-sim-user-commands-system"
                name="gz::sim::systems::UserCommands"/>

        <plugin filename="gz-sim-scene-broadcaster-system"
                name="gz::sim::systems::SceneBroadcaster"/> 

        <!-- Gravitasjon -->

        <gravity>0 0 -9.81</gravity>

        <!-- Belysning -->

        <light name="sun" type="directional">
            <pose>0 0 10 0 0 0</pose>
            <cast_shadows>true</cast_shadows>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <direction>-0.5 0.1 -1</direction>
        </light>

        <!-- Gulv -->
        <!-- Gulvet legges 0.8 m under origo, det er ikke et prosjektkrav, skaper visuel realisme i miljøet -->

        <model name="ground_plane">
            <static>true</static>

            <pose>0 0 -0.8 0 0 0</pose>

            <link name="ground_link">

                <collision name="ground_collision">         <!-- Gulvets fysiske kollisjonsgeometri mellom objekter -->
                    <geometry>
                        <plane>
                            <normal>0 0 1</normal>
                            <size>15 15</size>
                        </plane>
                    </geometry>
                </collision>

                <visual name="ground_visual">               <!-- Gulvets visuelle geometri på 15 x 15 meter-->
                    <geometry>
                        <plane>
                            <normal>0 0 1</normal>
                            <size>15 15</size>
                        </plane>
                    </geometry>

                    <material>
                        <ambient>0.8 0.8 0.8 1</ambient>
                        <diffuse>0.8 0.8 0.8 1</diffuse>
                    </material>

                </visual>

            </link>
        </model>


<!-- Robotmiljøets komponenter er definert under -->

<!-- Transportbånd/Conveyor Belt -->
<!-- Dimensjoner basert på AutoCAD-tegning -->
<!-- Overflaten ligger ved z = 0 som i MATLAB for å ha felles referanseplan -->

<model name="conveyor_belt">

    <static>true</static>

    <pose>0 -0.575 -0.05 0 0 0</pose>       <!-- Tverrsnitt av transportbåndet, 
                                                det er egentlig uten tykkelse i matlab,     
                                                men for visualisering er det lagt til 0.1m
                                                derfor forskyver vi senteret ned 0.05m for å beholde z = 0 -->

    <link name="belt_link">

        <visual name="belt_visual">         <!-- Båndets visuelle geometri -->
            <geometry>
                <box>
                    <size>5.0 0.4 0.1</size>    
                </box>
            </geometry>

            <material>
                <ambient>0.15 0.15 0.15 1</ambient>
                <diffuse>0.15 0.15 0.15 1</diffuse>
            </material>
        </visual>

        <collision name="belt_collision">       <!-- Båndets fysiske kollisjonsgeometri -->
            <geometry>
                <box>
                    <size>5.0 0.4 0.1</size>
                </box>
            </geometry>
        </collision>

    </link>

</model>

<!-- Transportbåndets fire bein (antatt), alle 4 har lik struktur, men ulik posisjon og navn-->
<!-- Dimensjoner og plassering basert på miljøets geometri, de er lagt til for visualiseringens del, 
    da miljøet vårt ikke tok hensyn til de tidligere -->

<model name="belt_leg_1">
    <static>true</static>
    <pose>-2.3 -0.435 -0.45 0 0 0</pose>

    <link name="leg_link">
        <visual name="leg_visual">
            <geometry>
                <box>
                    <size>0.06 0.06 0.7</size>
                </box>
            </geometry>
            <material>
                <ambient>0.3 0.35 0.4 1</ambient>
                <diffuse>0.3 0.35 0.4 1</diffuse>
            </material>
        </visual>

        <collision name="leg_collision">
            <geometry>
                <box>
                    <size>0.06 0.06 0.7</size>
                </box>
            </geometry>
        </collision>
    </link>
</model>

<model name="belt_leg_2">
    <static>true</static>
    <pose>-2.3 -0.715 -0.45 0 0 0</pose>

    <link name="leg_link">
        <visual name="leg_visual">
            <geometry>
                <box>
                    <size>0.06 0.06 0.7</size>
                </box>
            </geometry>
            <material>
                <ambient>0.3 0.35 0.4 1</ambient>
                <diffuse>0.3 0.35 0.4 1</diffuse>
            </material>
        </visual>

        <collision name="leg_collision">
            <geometry>
                <box>
                    <size>0.06 0.06 0.7</size>
                </box>
            </geometry>
        </collision>
    </link>
</model>

<model name="belt_leg_3">
    <static>true</static>
    <pose>2.3 -0.435 -0.45 0 0 0</pose>

    <link name="leg_link">
        <visual name="leg_visual">
            <geometry>
                <box>
                    <size>0.06 0.06 0.7</size>
                </box>
            </geometry>
            <material>
                <ambient>0.3 0.35 0.4 1</ambient>
                <diffuse>0.3 0.35 0.4 1</diffuse>
            </material>
        </visual>

        <collision name="leg_collision">
            <geometry>
                <box>
                    <size>0.06 0.06 0.7</size>
                </box>
            </geometry>
        </collision>
    </link>
</model>

<model name="belt_leg_4">
    <static>true</static>
    <pose>2.3 -0.715 -0.45 0 0 0</pose>

    <link name="leg_link">
        <visual name="leg_visual">
            <geometry>
                <box>
                    <size>0.06 0.06 0.7</size>
                </box>
            </geometry>
            <material>
                <ambient>0.3 0.35 0.4 1</ambient>
                <diffuse>0.3 0.35 0.4 1</diffuse>
            </material>
        </visual>

        <collision name="leg_collision">
            <geometry>
                <box>
                    <size>0.06 0.06 0.7</size>
                </box>
            </geometry>
        </collision>
    </link>
</model>

<!-- Robotfundament med lengde og bredde fra AutoCAD.
     Tykkelsen er valgt for visualisering. -->


<!-- base/monteringsplate -->


<model name="robot_mounting_plate">
    <static>true</static>
    <pose>0 0.125 -0.05 0 0 0</pose>    <!-- Basen forsyves i positiv y-retning sånn at roboten står nærmere 
                                            kanten mot transportbåndet -->

    <link name="plate_link">

        <visual name="plate_visual">
            <geometry>
                <box>
                    <size>1.0 0.5 0.1</size>
                </box>
            </geometry>

            <material>
                <ambient>0.25 0.28 0.32 1</ambient>
                <diffuse>0.25 0.28 0.32 1</diffuse>
            </material>
        </visual>

        <collision name="plate_collision">
            <geometry>
                <box>
                    <size>1.0 0.5 0.1</size>
                </box>
            </geometry>
        </collision>

    </link>
</model>

<!-- Sokkel som visualiserer robotens fundament ved å fylle høyden mellom gulv og base, dimensjoner er antatt -->

<model name="robot_pedestal">
    <static>true</static>
    <pose>0 0.125 -0.45 0 0 0</pose>

    <link name="pedestal_link">

        <visual name="pedestal_visual">
            <geometry>
                <box>
                    <size>0.8 0.4 0.7</size>
                </box>
            </geometry>

            <material>
                <ambient>0.35 0.4 0.45 1</ambient>
                <diffuse>0.35 0.4 0.45 1</diffuse>
            </material>
        </visual>

        <collision name="pedestal_collision">
            <geometry>
                <box>
                    <size>0.8 0.4 0.7</size>
                </box>
            </geometry>
        </collision>

    </link>
</model>


<!-- Avlastningsbord/Drop-off location -->

<!-- Plassering, lengde og bredde basert på MATLAB-modellen.
     Tykkelse og bordbein er lagt til for visualisering -->

<model name="dropoff_table">

    <static>true</static>

    <pose>0 -0.975 -0.025 0 0 0</pose>      <!-- Bordplaten har en tykkelse på 0.05 m, senteret forskyves
                                                    derfor ned 0.025 m for å beholde overflaten ved z = 0 -->

    <link name="table_link">

        <!-- Bordplate -->

        <visual name="table_top_visual">
            <geometry>
                <box>
                    <size>0.4 0.4 0.05</size>
                </box>
            </geometry>

            <material>
                <ambient>0.1 0.65 0.55 1</ambient>
                <diffuse>0.1 0.65 0.55 1</diffuse>
            </material>
        </visual>

        <collision name="table_top_collision">
            <geometry>
                <box>
                    <size>0.4 0.4 0.05</size>
                </box>
            </geometry>
        </collision>

        <!-- Alle fire bordbein har lik geometri, men ulik posisjon.
     Beinas koordinater er relative til bordets koordinatsystem,
     slik at beina følger med om bordet flyttes -->

        <visual name="table_leg_1_visual">
            <pose>-0.15 0.15 -0.4 0 0 0</pose>
            <geometry>
                <box>
                    <size>0.04 0.04 0.75</size>         <!-- Beinlengden på 0.75 m fyller høyden mellom gulvet
                                                                og undersiden av bordplaten -->
                </box>
            </geometry>
            <material>
                <ambient>0.3 0.35 0.4 1</ambient>
                <diffuse>0.3 0.35 0.4 1</diffuse>
            </material>
        </visual>

        <collision name="table_leg_1_collision">
            <pose>-0.15 0.15 -0.4 0 0 0</pose>
            <geometry>
                <box>
                    <size>0.04 0.04 0.75</size>
                </box>
            </geometry>
        </collision>

        <!-- Bordbein 2 -->

        <visual name="table_leg_2_visual">
            <pose>0.15 0.15 -0.4 0 0 0</pose>
            <geometry>
                <box>
                    <size>0.04 0.04 0.75</size>
                </box>
            </geometry>
            <material>
                <ambient>0.3 0.35 0.4 1</ambient>
                <diffuse>0.3 0.35 0.4 1</diffuse>
            </material>
        </visual>

        <collision name="table_leg_2_collision">
            <pose>0.15 0.15 -0.4 0 0 0</pose>
            <geometry>
                <box>
                    <size>0.04 0.04 0.75</size>
                </box>
            </geometry>
        </collision>

        <!-- Bordbein 3 -->

        <visual name="table_leg_3_visual">
            <pose>-0.15 -0.15 -0.4 0 0 0</pose>
            <geometry>
                <box>
                    <size>0.04 0.04 0.75</size>
                </box>
            </geometry>
            <material>
                <ambient>0.3 0.35 0.4 1</ambient>
                <diffuse>0.3 0.35 0.4 1</diffuse>
            </material>
        </visual>

        <collision name="table_leg_3_collision">
            <pose>-0.15 -0.15 -0.4 0 0 0</pose>
            <geometry>
                <box>
                    <size>0.04 0.04 0.75</size>
                </box>
            </geometry>
        </collision>

        <!-- Bordbein 4 -->

        <visual name="table_leg_4_visual">
            <pose>0.15 -0.15 -0.4 0 0 0</pose>
            <geometry>
                <box>
                    <size>0.04 0.04 0.75</size>
                </box>
            </geometry>
            <material>
                <ambient>0.3 0.35 0.4 1</ambient>
                <diffuse>0.3 0.35 0.4 1</diffuse>
            </material>
        </visual>

        <collision name="table_leg_4_collision">
            <pose>0.15 -0.15 -0.4 0 0 0</pose>
            <geometry>
                <box>
                    <size>0.04 0.04 0.75</size>
                </box>
            </geometry>
        </collision>

    </link>

</model>

<!-- Kamerasystem -->
<!-- Plassering tar utgangspunkt i AutoCAD og MATLAB.
     Kamerahus, linse og stativ er forenklet for visualisering.
     Stativets oppbygging og lokale koordinater er foreslått
     med KI-assistanse.
     Kameraet fungerer ikke som en aktiv sensor i Gazebo -->

<model name="camera_system">

    <static>true</static>
    <pose>-2 -0.575 1.0 0 0 0</pose>            <!-- Kameraets referansepunkt plasseres 1 m over
                                                        transportbåndets senterlinje -->

    <link name="camera_link">

        <!-- Vertikal kamerastolpe -->

        <visual name="camera_pole_visual">
            <pose>0 -0.35 -0.85 0 0 0</pose>        <!-- Stolpen forskyves i negativ y-retning for å stå
                                                            på utsiden av transportbåndet -->

            <geometry>
                <box>
                    <size>0.06 0.06 1.9</size>
                </box>
            </geometry>

            <material>
                <ambient>0.3 0.35 0.4 1</ambient>
                <diffuse>0.3 0.35 0.4 1</diffuse>
            </material>
        </visual>

        <collision name="camera_pole_collision">
            <pose>0 -0.35 -0.85 0 0 0</pose>
            <geometry>
                <box>
                    <size>0.06 0.06 1.9</size>
                </box>
            </geometry>
        </collision>
        
        <!-- Horisontal kameraholder mellom stolpen og kamerahuset.
     Posisjonen er relativ til kameraets koordinatsystem -->

        <visual name="camera_bracket_visual">
            <pose>0 -0.175 0.07 0 0 0</pose>

            <geometry>
                <box>
                    <size>0.06 0.35 0.06</size>
                </box>
            </geometry>

            <material>
                <ambient>0.3 0.35 0.4 1</ambient>
                <diffuse>0.3 0.35 0.4 1</diffuse>
            </material>
        </visual>

        <collision name="camera_bracket_collision">
            <pose>0 -0.175 0.07 0 0 0</pose>
            <geometry>
                <box>
                    <size>0.06 0.35 0.06</size>
                </box>
            </geometry>
        </collision>

        <!-- Kamerahuset visualiseres som en gul boks -->

        <visual name="camera_body_visual">
            <pose>0 0 0.07 0 0 0</pose>

            <geometry>
                <box>
                    <size>0.1 0.08 0.1</size>
                </box>
            </geometry>

            <material>
                <ambient>0.95 0.75 0.05 1</ambient>
                <diffuse>0.95 0.75 0.05 1</diffuse>
            </material>
        </visual>

        <collision name="camera_body_collision">
            <pose>0 0 0.07 0 0 0</pose>
            <geometry>
                <box>
                    <size>0.1 0.08 0.1</size>
                </box>
            </geometry>
        </collision>

        <!-- Linsen visualiseres som en sylinder på undersiden
                av kamerahuset, med diameter på 0.04 m -->
                
                    

        <visual name="camera_lens_visual">
            <pose>0 0 0.01 0 0 0</pose>

            <geometry>
                <cylinder>
                    <radius>0.02</radius>
                    <length>0.02</length>
                </cylinder>
            </geometry>

            <material>
                <ambient>0.05 0.05 0.05 1</ambient>
                <diffuse>0.05 0.05 0.05 1</diffuse>
            </material>
        </visual>

        <collision name="camera_lens_collision">
            <pose>0 0 0.01 0 0 0</pose>
            <geometry>
                <cylinder>
                    <radius>0.02</radius>
                    <length>0.02</length>
                </cylinder>
            </geometry>
        </collision>

    </link>

</model>

<!-- Pick-up object -->
<!-- Objektet representeres som en kube på 100 x 100 x 100 mm.
     Dimensjonene er antatt for visualisering -->

<model name="pick_object">

    <static>true</static>                   <!-- Objektet er stillestående i Gazebo, bevegelsen
                                                langs transportbåndet modelleres i MATLAB -->

    <pose>-2 -0.575 0.05 0 0 0</pose>           <!-- Objektet plasseres under kameraet på transportbåndet.
                                                    Senteret løftes 0.05 m slik at undersiden ligger ved z = 0 -->

    <link name="object_link">

        <visual name="object_visual">
            <geometry>
                <box>
                    <size>0.1 0.1 0.1</size>
                </box>
            </geometry>

            <material>
                <ambient>0.95 0.35 0.05 1</ambient>
                <diffuse>0.95 0.35 0.05 1</diffuse>
            </material>
        </visual>

        <collision name="object_collision">
            <geometry>
                <box>
                    <size>0.1 0.1 0.1</size>
                </box>
            </geometry>
        </collision>

    </link>

</model>

    </world>

</sdf>